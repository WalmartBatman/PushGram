<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Header card: my stats -->
    <LinearLayout android:id="@+id/headerLeader"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/card_bg"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <Button android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:text="←" android:textSize="18sp"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white" android:padding="0dp"/>

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/activity_leaderboard_leaderboard" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/white" android:fontFamily="sans-serif-black"
                android:layout_marginStart="8dp"/>

            <Button android:id="@+id/btnEditName"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="@string/activity_leaderboard_name" android:textSize="11sp"
                android:backgroundTint="@color/divider" android:textColor="@color/white"
                app:cornerRadius="16dp"/>
        </LinearLayout>

        <!-- My profile row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/counter_bg_orange" android:padding="12dp"
            android:layout_marginTop="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvMyName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_leaderboard_athlete" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/white"/>
                <TextView android:id="@+id/tvMyRank"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_exercises_rookie" android:textSize="14sp"
                    android:textColor="@color/accent_orange" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/tvMyXp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_exercises_0xp" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/accent_orange"/>
                <TextView android:id="@+id/tvMyReps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_leaderboard_0totalreps" android:textSize="11sp"
                    android:textColor="@color/text_secondary"/>
                <TextView android:id="@+id/tvMyPosition"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_leaderboard_yourrank" android:textSize="12sp"
                    android:textColor="@color/accent_blue" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Tab buttons -->
    <LinearLayout android:id="@+id/tabs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        app:layout_constraintTop_toBottomOf="@id/headerLeader">

        <Button android:id="@+id/btnLocalTab"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="@string/activity_leaderboard_local" android:textSize="14sp" android:textStyle="bold"
            android:backgroundTint="@android:color/transparent" android:textColor="@color/accent_orange"/>

        <Button android:id="@+id/btnGlobalTab"
            android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:text="@string/activity_leaderboard_global" android:textSize="14sp" android:textStyle="bold"
            android:backgroundTint="@android:color/transparent" android:textColor="@color/text_secondary"
            android:alpha="0.5"/>
    </LinearLayout>

    <!-- Title + subtitle -->
    <LinearLayout android:id="@+id/leaderTitle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/tabs">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvLeaderboardTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/activity_leaderboard_localrankings" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/white"/>
            <TextView android:id="@+id/tvLeaderboardSubtitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/activity_leaderboard_playersonthisdevice" android:textSize="12sp"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/progressLoading"
            android:layout_width="24dp" android:layout_height="24dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Leaderboard list -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvLeaderboard"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:clipToPadding="false" android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/leaderTitle"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
