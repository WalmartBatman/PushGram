<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="24dp">
            <Button android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:text="←" android:textSize="18sp"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white" android:padding="0dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⚔️ Battle Mode" android:textSize="24sp" android:textStyle="bold"
                android:textColor="@color/white" android:fontFamily="sans-serif-black"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Firebase warning -->
        <TextView android:id="@+id/tvFirebaseWarning"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⚠️ Battle mode requires Firebase setup.\nSee README for instructions."
            android:textSize="13sp" android:textColor="#FFDD88"
            android:background="@color/card_bg" android:padding="12dp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <!-- Exercise picker -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Choose exercise:" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginBottom="8dp"/>

        <Spinner android:id="@+id/spinnerExercise"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@color/card_bg"
            android:layout_marginBottom="24dp"/>

        <!-- How it works -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@color/card_bg"
            android:padding="16dp" android:layout_marginBottom="24dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="⚔️ How Battle Works"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/white"
                android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="• 60 seconds. Most reps wins.\n• Camera detects your real reps.\n• Winner gets 500 XP, loser gets 100 XP.\n• Both players need the app installed.\n• Share your room code for opponent to join."
                android:textSize="13sp" android:textColor="@color/text_secondary"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Create room -->
        <Button android:id="@+id/btnCreate"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:text="⚔️ CREATE ROOM"
            android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="@color/accent_orange"
            android:textColor="@color/bg_dark"
            app:cornerRadius="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- Room code display after creating -->
        <TextView android:id="@+id/tvShareCode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/accent_orange"
            android:gravity="center" android:background="@color/card_bg" android:padding="16dp"
            android:layout_marginBottom="16dp" android:visibility="gone"/>

        <!-- Divider -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginVertical="8dp">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"
                android:background="@color/divider"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" OR " android:textSize="13sp" android:textColor="@color/text_secondary"
                android:layout_marginHorizontal="8dp"/>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"
                android:background="@color/divider"/>
        </LinearLayout>

        <!-- Join room -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Enter room code:" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/white" android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"/>

        <android.widget.EditText android:id="@+id/etRoomCode"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:hint="e.g. ABC123" android:textSize="22sp" android:textStyle="bold"
            android:inputType="textCapCharacters" android:maxLength="6"
            android:gravity="center" android:letterSpacing="0.3"
            android:background="@color/card_bg" android:textColor="@color/accent_orange"
            android:layout_marginBottom="12dp"/>

        <Button android:id="@+id/btnJoin"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:text="JOIN ROOM"
            android:textSize="16sp" android:textStyle="bold"
            android:backgroundTint="@color/card_bg"
            android:textColor="@color/accent_blue"
            app:cornerRadius="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Loading -->
        <ProgressBar android:id="@+id/progressBattle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:visibility="gone"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</ScrollView>
