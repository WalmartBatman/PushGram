<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Header -->
    <LinearLayout android:id="@+id/headerExercises"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@color/card_bg"
        android:paddingHorizontal="16dp" android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp"
                android:text="←" android:textSize="18sp" android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white" android:padding="0dp"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🏋️ Exercises" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/white" android:fontFamily="sans-serif-black" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Rank bar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
            <TextView android:id="@+id/tvRank" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🥉 Rookie" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/accent_orange"/>
            <TextView android:id="@+id/tvXp" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="0 XP" android:textSize="13sp"
                android:textColor="@color/text_secondary" android:gravity="end"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/rankProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="8dp"
            android:progressTint="@color/accent_orange" android:progress="0" android:layout_marginTop="6dp"/>
        <TextView android:id="@+id/tvXpToNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="500 XP to Bronze" android:textSize="11sp" android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView android:id="@+id/scrollFilters"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerExercises">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="12dp">
            <Button android:id="@+id/chipAll" android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="All" android:textSize="12sp" android:backgroundTint="#FF6B35"
                app:cornerRadius="18dp" android:textColor="@color/bg_dark" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/chipPush" android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="💪 Push" android:textSize="12sp" android:backgroundTint="@color/card_bg"
                app:cornerRadius="18dp" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/chipPull" android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="🔝 Pull" android:textSize="12sp" android:backgroundTint="@color/card_bg"
                app:cornerRadius="18dp" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/chipLegs" android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="🦵 Legs" android:textSize="12sp" android:backgroundTint="@color/card_bg"
                app:cornerRadius="18dp" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/chipCore" android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="🎯 Core" android:textSize="12sp" android:backgroundTint="@color/card_bg"
                app:cornerRadius="18dp" android:textColor="@color/white" android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/chipSkills" android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="⚡ Skills" android:textSize="12sp" android:backgroundTint="@color/card_bg"
                app:cornerRadius="18dp" android:textColor="@color/white"/>
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvExercises"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:clipToPadding="false" android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/scrollFilters"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
