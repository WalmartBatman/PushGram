<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/card_bg"
    android:padding="12dp"
    android:layout_marginBottom="2dp">

    <!-- Level number circle -->
    <TextView android:id="@+id/tvLevelNumber"
        android:layout_width="36dp" android:layout_height="36dp"
        android:text="@string/item_progression_level_1" android:textSize="16sp" android:textStyle="bold"
        android:textColor="@color/white" android:gravity="center"
        android:background="@color/divider"/>

    <!-- Name + goal -->
    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView android:id="@+id/tvLevelName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/item_progression_level_wallpushup" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/white"/>

        <TextView android:id="@+id/tvLevelGoal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/item_progression_level_315reps2xprep" android:textSize="12sp"
            android:textColor="@color/text_secondary" android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Status badge -->
    <TextView android:id="@+id/tvLevelStatus"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/item_progression_level_current" android:textSize="12sp"
        android:textColor="@color/accent_orange"/>

</LinearLayout>
