<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/card_bg"
            android:padding="16dp">

            <Button android:id="@+id/btnBack"
                android:layout_width="40dp" android:layout_height="40dp"
                android:text="←" android:textSize="18sp"
                android:backgroundTint="@android:color/transparent"
                android:textColor="@color/white" android:padding="0dp"/>

            <TextView android:id="@+id/tvExerciseEmoji"
                android:layout_width="56dp" android:layout_height="56dp"
                android:text="@string/activity_exercise_detail" android:textSize="32sp" android:gravity="center"
                android:background="@color/divider" android:layout_marginStart="8dp"/>

            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView android:id="@+id/tvExerciseName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_exercise_detail_pushup" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="@color/white" android:fontFamily="sans-serif-black"/>

                <TextView android:id="@+id/tvExerciseCategory"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_exercise_detail_push" android:textSize="13sp"
                    android:textColor="@color/accent_orange" android:layout_marginTop="2dp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Description -->
        <TextView android:id="@+id/tvExerciseDescription"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="16dp" android:paddingTop="16dp"/>

        <TextView android:id="@+id/tvEquipment"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/accent_blue"
            android:paddingHorizontal="16dp" android:paddingTop="6dp"/>

        <!-- ── MUSCLE TARGETING ── -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/activity_exercise_detail_muscletargeting"
            android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.1"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="16dp" android:paddingTop="24dp" android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:layout_marginHorizontal="12dp"
            android:paddingHorizontal="16dp" android:paddingVertical="14dp">

            <TextView android:id="@+id/tvMusclesList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/white"
                android:lineSpacingExtra="6dp"/>
        </LinearLayout>

        <!-- ── CURRENT LEVEL ── -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/activity_exercise_detail_currentprogress"
            android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.1"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="16dp" android:paddingTop="24dp" android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_bg"
            android:paddingHorizontal="16dp" android:paddingVertical="16dp"
            android:layout_marginHorizontal="12dp">

            <!-- Level name + progress -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/tvCurrentLevelName"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/activity_exercise_detail_level1wallpushu" android:textSize="17sp"
                    android:textStyle="bold" android:textColor="@color/accent_orange"
                    android:fontFamily="sans-serif-black"/>
                <TextView android:id="@+id/tvProgressionLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_exercise_detail_15" android:textSize="13sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <ProgressBar android:id="@+id/progressionBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp"
                android:progressTint="@color/accent_orange"
                android:progress="20" android:layout_marginTop="8dp"/>

            <TextView android:id="@+id/tvCurrentLevelDesc"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="@color/white"
                android:lineSpacingExtra="3dp" android:layout_marginTop="12dp"/>

            <TextView android:id="@+id/tvCurrentLevelGoal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/activity_exercise_detail_goal315reps" android:textSize="14sp"
                android:textStyle="bold" android:textColor="@color/accent_blue"
                android:layout_marginTop="8dp"/>

            <TextView android:id="@+id/tvFormCue"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FFDD88"
                android:lineSpacingExtra="3dp" android:layout_marginTop="8dp"
                android:background="@color/divider" android:padding="10dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">

                <TextView android:id="@+id/tvXpPerRep"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/activity_exercise_detail_4xpperrep" android:textSize="13sp"
                    android:textColor="@color/success_green" android:textStyle="bold"/>

                <Button android:id="@+id/btnAdvanceLevel"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:text="@string/activity_exercise_detail_advancetolevel2"
                    android:textSize="11sp"
                    android:backgroundTint="@color/divider"
                    android:textColor="@color/white"
                    app:cornerRadius="18dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── PROGRESSION PATH ── -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/activity_exercise_detail_progressionpath"
            android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.1"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="16dp" android:paddingTop="24dp" android:paddingBottom="8dp"/>

        <LinearLayout android:id="@+id/layoutProgressionPath"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"/>

        <!-- ── PERSONAL STATS ── -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/activity_exercise_detail_yourstats"
            android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.1"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="16dp" android:paddingTop="24dp" android:paddingBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/card_bg"
            android:paddingVertical="16dp"
            android:layout_marginHorizontal="12dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvBestReps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_battle_0" android:textSize="32sp" android:textStyle="bold"
                    android:textColor="@color/accent_orange" android:fontFamily="sans-serif-black"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_exercise_detail_bestreps" android:textSize="11sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvTotalReps"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_battle_0" android:textSize="32sp" android:textStyle="bold"
                    android:textColor="@color/accent_blue" android:fontFamily="sans-serif-black"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_exercise_detail_totalreps" android:textSize="11sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvWorkoutCount"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_battle_0" android:textSize="32sp" android:textStyle="bold"
                    android:textColor="@color/success_green" android:fontFamily="sans-serif-black"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/activity_exercise_detail_sessions" android:textSize="11sp" android:textColor="@color/text_secondary"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Log Workout Button -->
        <Button android:id="@+id/btnLogWorkout"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:text="@string/activity_exercise_detail_logworkout"
            android:textSize="15sp" android:textStyle="bold"
            android:backgroundTint="@color/accent_orange"
            android:textColor="@color/bg_dark"
            app:cornerRadius="16dp"
            android:layout_marginHorizontal="16dp" android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>
