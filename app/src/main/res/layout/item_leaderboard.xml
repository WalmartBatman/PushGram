<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Rank number / medal -->
    <TextView android:id="@+id/tvLeaderRank"
        android:layout_width="40dp" android:layout_height="wrap_content"
        android:text="@string/item_leaderboard_1" android:textSize="18sp" android:textStyle="bold"
        android:textColor="@color/accent_orange" android:gravity="center"/>

    <!-- Name + tier -->
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView android:id="@+id/tvLeaderName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/item_leaderboard_ironmike" android:textSize="15sp" android:textStyle="bold"
            android:textColor="@color/white" android:maxLines="1" android:ellipsize="end"/>

        <TextView android:id="@+id/tvLeaderTier"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/item_leaderboard_gold" android:textSize="12sp" android:textColor="#FFD700"/>
    </LinearLayout>

    <!-- XP -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="end" android:layout_marginStart="8dp">

        <TextView android:id="@+id/tvLeaderXp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/item_leaderboard_8420xp" android:textSize="14sp" android:textStyle="bold"
            android:textColor="@color/accent_orange"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/tvLeaderReps"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/item_leaderboard_2100reps" android:textSize="11sp"
                android:textColor="@color/text_secondary"/>

            <TextView android:id="@+id/tvLeaderWins"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/item_leaderboard_12w" android:textSize="11sp"
                android:textColor="@color/success_green"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
