<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Camera feed -->
    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter"/>

    <!-- Gradient overlays top + bottom -->
    <View android:layout_width="match_parent" android:layout_height="160dp"
        android:layout_gravity="top"
        android:background="@drawable/gradient_top_overlay"/>
    <View android:layout_width="match_parent" android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_bottom_overlay"/>

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="16dp"
        android:paddingTop="48dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="✕"
            android:textSize="16sp"
            android:backgroundTint="#33FFFFFF"
            android:textColor="@color/white"
            android:padding="0dp"
            app:cornerRadius="20dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Push-up Mode"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:fontFamily="sans-serif-black"/>

        <TextView
            android:id="@+id/tvPhase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"/>
        <Button
            android:id="@+id/btnFlipCamera"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🔄"
            android:textSize="16sp"
            android:backgroundTint="#33FFFFFF"
            android:textColor="@color/white"
            android:padding="0dp"
            android:layout_marginStart="8dp"
            app:cornerRadius="20dp"/>
    </LinearLayout>

    <!-- Bottom HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp"
        android:paddingTop="16dp"
        android:gravity="center">

        <!-- Form feedback pill -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Position yourself for push-ups"
            android:textSize="14sp"
            android:textColor="#EEFFFFFF"
            android:textAlignment="center"
            android:background="@drawable/bg_feedback_pill"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="24dp"/>

        <!-- Rep counters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <!-- Rep count -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_counter_dark"
                android:layout_marginEnd="8dp">
                <TextView
                    android:id="@+id/tvSessionReps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:fontFamily="sans-serif-black"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Push-ups"
                    android:textSize="11sp"
                    android:textColor="#88FFFFFF"/>
            </LinearLayout>

            <!-- Credits earned -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_counter_orange"
                android:layout_marginStart="8dp">
                <TextView
                    android:id="@+id/tvSessionCredits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="52sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_orange"
                    android:fontFamily="sans-serif-black"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credits"
                    android:textSize="11sp"
                    android:textColor="#88FFFFFF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Total credits row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_counter_dark"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total reel credits"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"/>
            <TextView
                android:id="@+id/tvTotalCredits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/accent_orange"
                android:fontFamily="sans-serif-black"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🎬"
                android:textSize="16sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Credit earned toast -->
    <TextView
        android:id="@+id/tvCreditToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="+1 🎬 Reel Credit!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/toast_bg"
        android:paddingHorizontal="28dp"
        android:paddingVertical="14dp"
        android:visibility="gone"/>

</FrameLayout>
